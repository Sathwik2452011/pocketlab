# Copy to .env and fill in. Leave IMAGE_API_KEY empty to run in sample mode.
IMAGE_PROVIDER=openai-compatible   # or: custom
IMAGE_API_KEY=
IMAGE_MODEL=                       # exact model name from your provider's docs
IMAGE_BASE_URL=                    # optional; default https://api.openai.com/v1
IMAGE_SIZE=1024x1024               # optional; must be a size your model supports
PORT=3000
